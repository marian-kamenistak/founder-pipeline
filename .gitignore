# Python — both shipped scripts regenerate these on first run, and the bytecode
# embeds source string literals from before the de-brand pass.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# Secrets — nothing in this repo should ever need them, which is exactly why
# the ignore goes in before the first commit rather than after the first leak.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.dev.vars

# Agent and editor state
.memsearch/
.claude/settings.local.json
*.local.md
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Working files that must not ship
# Dated audit notes only. A bare AUDIT-*.md also matched references/audit-mode.md on a
# case-insensitive disk, and that file was missing from 0.1.0 and 0.2.0.
AUDIT-[0-9]*.md
*.bak
*.orig
*.tmp

# Eval run output (regenerated by `claude plugin eval`); the release summary lives in docs/
plugins/founder-pipeline/evals/results/

# Local release-scan identity patterns (private names to scan for; never committed)
.release-identity
